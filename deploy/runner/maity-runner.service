# systemd SYSTEM unit (root-owned, /etc/systemd/system/maity-runner.service). The runner
# runs as its own user, but the unit, the runner files and the hook are not the runner
# user's to change. Replace <runner-user> and <uid> (see README.md).
[Unit]
Description=GitHub Actions runner for the Maity database jobs
After=network-online.target user@<uid>.service
Wants=network-online.target
Requires=user@<uid>.service

[Service]
User=<runner-user>
WorkingDirectory=/opt/actions-runner
# The rootless Docker of the runner user (lingering keeps it running).
Environment=DOCKER_HOST=unix:///run/user/<uid>/docker.sock
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED=/opt/maity-runner-hooks/job-completed.sh
ExecStart=/opt/actions-runner/run.sh
Restart=always
RestartSec=10
# A restart also ends the processes a job left behind.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
